# Standalone Tasks runtime. All values are server-only and read at runtime.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Must match the root caller; generate with `openssl rand -hex 32`.
TASKS_SERVICE_AUTH_SECRET=
# Optional operator-check assertion, not read by the service itself.
TASKS_CANARY_EXPECTED_STAGE=standalone_runtime_ready

# Standalone Subscriptions runtime. All values are server-only and read at runtime.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Must match the root caller; generate with `openssl rand -hex 32`.
SUBSCRIPTIONS_SERVICE_AUTH_SECRET=
# This deployment calls Tasks to provision payment tasks — same values Tasks itself uses.
TASKS_API_URL=https://your-tasks-deployment.example.com
TASKS_SERVICE_AUTH_SECRET=
# Optional operator-check assertion, not read by the service itself.
SUBSCRIPTIONS_CANARY_EXPECTED_STAGE=standalone_runtime_ready

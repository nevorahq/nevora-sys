# Supabase (public client credentials)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@example.com

# Supabase service-role key — SERVER-ONLY, никогда не отдаётся клиенту.
# Используется для серверного rate-лимитера (вызов check_rate_limit, доступного
# только service_role) и durable extraction sweep-воркера (cross-org доступ).
# Если не задан — rate limiting и sweep деградируют в no-op (fail-open).
SUPABASE_SERVICE_ROLE_KEY=

# Resend transactional email. Use a verified sender/domain in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Nevora <bookings@example.com>"

# Anthropic — powers the AI module (summaries, insights, recommendations)
# and Document-to-Transaction extraction (OCR/vision normalization).
ANTHROPIC_API_KEY=

# Billing mode.
# private_beta disables self-serve paid checkout and Customer Portal.
# paid_beta/production require server-side Paddle secrets, webhook secret, and paid Price IDs.
BILLING_MODE=private_beta
BILLING_PROVIDER=paddle

# Paddle
PADDLE_ENV=sandbox
PADDLE_API_KEY=pdl_sdbx_your_api_key
PADDLE_CLIENT_TOKEN=test_your_client_token
PADDLE_WEBHOOK_SECRET=pdl_ntfset_your_notification_destination_secret
PADDLE_SELLER_ID=your_paddle_seller_id

# Paddle Price IDs
PADDLE_PRICE_STARTER_MONTHLY=pri_your_starter_monthly_price_id
PADDLE_PRICE_STARTER_YEARLY=pri_your_starter_yearly_price_id
PADDLE_PRICE_PRO_MONTHLY=pri_your_pro_monthly_price_id
PADDLE_PRICE_PRO_YEARLY=pri_your_pro_yearly_price_id
PADDLE_PRICE_BUSINESS_MONTHLY=pri_your_business_monthly_price_id
PADDLE_PRICE_BUSINESS_YEARLY=pri_your_business_yearly_price_id

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Tasks cutover: in-process → shadow → http-read → http. Shadow keeps local
# reads authoritative and compares a sample remotely; http-read moves reads
# with local fallback but keeps writes local; http moves writes with no retry.
TASKS_TRANSPORT=in-process
TASKS_API_URL=
TASKS_SHADOW_READ_PERCENT=100
# Shared only by trusted Tasks runtimes. Use at least 32 random characters
# (`openssl rand -hex 32`). It signs short-lived, operation-bound service claims.
TASKS_SERVICE_AUTH_SECRET=

# Optional operator-only inputs for `npm run canary:tasks`. Use an active member
# in a non-production test tenant when possible. These values are never exposed.
TASKS_CANARY_SOURCE_URL=
TASKS_CANARY_ORGANIZATION_ID=
TASKS_CANARY_WORKSPACE_ID=
TASKS_CANARY_ACTOR_ID=
# Optional health identity assertion; normally keep the default.
TASKS_CANARY_EXPECTED_STAGE=standalone_runtime_ready

# Document-to-Transaction: when "1"/"true", stubs AI extraction (no Anthropic
# credits) for local testing. Leave unset/"0" for real extraction.
DOCUMENT_EXTRACTION_MOCK=0

# Cron auth — REQUIRED for /api/cron/extraction-sweep (fail-closed). Generate
# with `openssl rand -hex 32` and set the same value in Vercel project env.
# Vercel Cron sends it automatically as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# Internal metrics auth — REQUIRED for /api/internal/activation-funnel and
# /api/internal/job-health (fail-closed: unset means both endpoints refuse to
# answer). Both are cross-org, product/ops-team diagnostics and return aggregate
# counts only. Send as `Authorization: Bearer <METRICS_SECRET>`. Generate with
# `openssl rand -hex 32`; keep it distinct from CRON_SECRET so leaking one does
# not hand over the other.
METRICS_SECRET=

# Error monitoring (Phase 2 — observability). OPTIONAL. Unset = failures are
# logged only (structured JSON) and never sent anywhere. Setting a DSN "arms" the
# monitoring seam; a provider adapter (Sentry SDK) must then be installed to
# actually deliver events — see docs/observability/sentry-setup.md.
# SENTRY_DSN is server-only (server actions, route handlers, RSC, cron).
# NEXT_PUBLIC_SENTRY_DSN is exposed to the browser (client-side errors).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Set to "1" to enable the opt-in DB-backed integration test
# (extraction-pipeline.integration.test.ts). Requires the Supabase env above and
# a LOCAL/test database — never run against production.
RUN_DB_TESTS=

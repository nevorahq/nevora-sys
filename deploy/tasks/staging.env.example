# Always deploy the immutable sha tag printed by the publish workflow.
TASKS_IMAGE=ghcr.io/nevorahq/nevora-tasks:sha-REPLACE_WITH_FULL_GIT_SHA
TASKS_BIND_ADDRESS=127.0.0.1
TASKS_PORT=3001
TASKS_MEMORY_LIMIT=512m
TASKS_CPU_LIMIT=0.50

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Must match the root application. Generate with `openssl rand -hex 32`.
TASKS_SERVICE_AUTH_SECRET=

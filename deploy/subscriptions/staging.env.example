# Always deploy the immutable sha tag printed by the publish workflow.
SUBSCRIPTIONS_IMAGE=ghcr.io/nevorahq/nevora-subscriptions:sha-REPLACE_WITH_FULL_GIT_SHA
SUBSCRIPTIONS_BIND_ADDRESS=127.0.0.1
SUBSCRIPTIONS_PORT=3002
SUBSCRIPTIONS_MEMORY_LIMIT=512m
SUBSCRIPTIONS_CPU_LIMIT=0.50

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Must match the root application. Generate with `openssl rand -hex 32`.
SUBSCRIPTIONS_SERVICE_AUTH_SECRET=

# Subscriptions has no in-process fallback for payment-task provisioning — both
# of these must point at a real, reachable Tasks deployment before this
# service can accept write traffic.
TASKS_API_URL=https://tasks.your-domain.example
# Must match the root application's TASKS_SERVICE_AUTH_SECRET.
TASKS_SERVICE_AUTH_SECRET=
